# LLM (optional — without key, responses use curated knowledge templates)
# OpenAI / ChatGPT (default)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Leave empty for api.openai.com; set for Grok e.g. https://api.x.ai/v1
LLM_BASE_URL=

# Disease model (Phase 1 output on Hugging Face; wired into the API in Phase 5)
HF_MODEL_ID=neghani/plantvillage-mobilenetv2
HF_MODEL_REVISION=v1.0
# Only needed if the model repo is private
HF_TOKEN=
# Placeholder prediction (Phase 5: use reports/metrics.json -> recommended_confidence_threshold)
CONFIDENCE_THRESHOLD=0.6
DEFAULT_LANGUAGE=en

# Next.js UI (browser calls host-mapped API port in Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000
