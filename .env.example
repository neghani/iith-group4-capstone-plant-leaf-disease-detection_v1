# LLM (optional — without key, responses use curated knowledge templates)
# OpenAI / ChatGPT (default)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Leave empty for api.openai.com; set for Grok e.g. https://api.x.ai/v1
LLM_BASE_URL=

# Placeholder prediction
CONFIDENCE_THRESHOLD=0.6
DEFAULT_LANGUAGE=en

# Next.js UI (browser calls host-mapped API port in Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000
