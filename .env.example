# LLM (optional — without key, responses use curated knowledge templates)
# OpenAI / ChatGPT (default)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Leave empty for api.openai.com; set for Grok e.g. https://api.x.ai/v1
LLM_BASE_URL=

# Disease model. Defaults (id, revision, threshold, T, crop, ood) live in shared/release.json.
# Uncomment only to override that pin. After a new Hub tag, edit release.json, not this file.
# Live pin is MobileNet v1.1; ResNet is the candidate block in release.json until it passes the field gate.
# HF_MODEL_ID=neghani/plantvillage-mobilenetv2
# HF_MODEL_REVISION=v1.1
# Serverless HF inference does not host this fine-tune: point this at a dedicated
# Inference Endpoint or a Docker Space built from hf_space/ (needs HF PRO for new Docker Spaces).
# Local fallback: docker compose up inference-service, then HF_ENDPOINT_URL=http://localhost:7860/
HF_ENDPOINT_URL=
# Needed for private Inference Endpoints / Spaces
HF_TOKEN=
HF_TIMEOUT_SECONDS=30
# Largest accepted upload (bytes). Big phone photos are decoded with JPEG draft mode and downscaled.
# MAX_IMAGE_BYTES=26214400
# CROP_STRATEGY=B
# CONFIDENCE_THRESHOLD=0.5
# CALIBRATION_TEMPERATURE=0.8845188130635788
# OOD_THRESHOLD=0.05
DEFAULT_LANGUAGE=en

# Kaggle download of the 19-crop MasterDataset (model/download_masterdataset.py).
# Leave unset to use kagglehub, which can fetch this public dataset without a token.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Next.js UI (browser calls host-mapped API port in Docker).
# Leave empty when building the all-in-one image (same origin via nginx).
NEXT_PUBLIC_API_URL=http://localhost:8000
